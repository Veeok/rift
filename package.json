{
  "name": "rift-bridge",
  "version": "0.3.0",
  "private": true,
  "description": "Rift: local Roblox client inspection, diagnostics, activity and explicit visual review for OpenCode.",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "rift": "dist/cli.js" },
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=tap test/*.test.mjs",
    "rift": "node dist/cli.js",
    "serve": "node dist/cli.js serve",
    "setup": "node dist/setup.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
